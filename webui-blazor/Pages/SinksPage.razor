@page "/Sinks"
@using AesDaemonWebUI.Models
@using AesDaemonWebUI.Services
@inject DaemonApiClient Api
@inject NavigationManager Nav

<div id="sinks">
    @if (_loading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div id="sinks-table">
            <table class="table-stream"><tbody>
                @if (_sinks.Count > 0)
                {
                    <tr class="tr-stream">
                        <th>ID</th>
                        <th>Name</th>
                        <th>NMOS Name</th>
                        <th>Channels</th>
                        <th>Status</th>
                        <th>Errors</th>
                        <th>Min. arrival time</th>
                        <th>Leg</th>
                    </tr>
                    @foreach (var sink in _sinks)
                    {
                        <SinkRow @key="sink.Id" Sink="sink" Hostname="@_hostname" OnEditClick="OnEditClick" OnTrashClick="OnTrashClick" />
                    }
                }
                else
                {
                    <tr><th>No sinks configured</th></tr>
                }
            </tbody></table>
            &nbsp;
            <span class="pointer-area" @onclick="Reload"><img width="30" height="30" src="img/reload.png" alt="" /></span>
            &nbsp;&nbsp;
            @if (_sinks.Count < 64)
            {
                <span class="pointer-area" @onclick="AddNew"><img width="30" height="30" src="img/plus.png" alt="" /></span>
            }
        </div>
    }
</div>

@if (_editVisible)
{
    <SinkEditModal Title="@_editTitle" IsEdit="_isEdit" Sink="_editSink" AllSinks="_sinks" OnClose="CloseEdit" OnApplied="ApplyEdit" />
}

@if (_removeVisible)
{
    <ConfirmModal Visible="true" Title="@($"Remove sink {_removeSink?.Id}")" Busy="_removing" ErrorMessage="_removeError" OnConfirm="ConfirmRemove" OnCancel="CloseEdit" />
}

@code {
    private List<SinkInfo> _sinks = new();
    private bool _loading = true;
    private string _hostname = "";

    private bool _editVisible;
    private bool _isEdit;
    private string _editTitle = "";
    private SinkInfo _editSink = new();

    private bool _removeVisible;
    private bool _removing;
    private string? _removeError;
    private SinkInfo? _removeSink;

    protected override async Task OnInitializedAsync() => await FetchSinks();

    private async Task FetchSinks()
    {
        _loading = true;
        try
        {
            var sinksTask = Api.GetSinksAsync();
            var config = await Api.GetConfigAsync();
            _hostname = config.NmosLabel;
            _sinks = (await sinksTask).OrderBy(s => s.Id).ToList();
        }
        catch (DaemonApiException)
        {
            // Leave the last-known list in place rather than blanking the page.
        }
        finally
        {
            _loading = false;
        }
    }

    private Task Reload() => FetchSinks();

    private void OnEditClick(int id)
    {
        var sink = _sinks.FirstOrDefault(s => s.Id == id);
        if (sink == null)
        {
            return;
        }
        _editTitle = $"Edit Sink {id}";
        _editSink = sink;
        _isEdit = true;
        _editVisible = true;
    }

    private void OnTrashClick(int id)
    {
        _removeSink = _sinks.FirstOrDefault(s => s.Id == id);
        _removeError = null;
        _removeVisible = _removeSink != null;
    }

    private void AddNew()
    {
        int id;
        for (id = 0; id < 63; id++)
        {
            if (id >= _sinks.Count || _sinks[id].Id != id)
            {
                break;
            }
        }
        var channelStart = AudioPacketMath.FindNextFreeChannelStart(_sinks.Select(s => s.Map), 2);
        _editSink = new SinkInfo
        {
            Id = id,
            Name = $"ALSA Sink {id}",
            Io = "Audio Device",
            Delay = 576,
            UseSdp = false,
            Source = $"{Nav.BaseUri.TrimEnd('/')}/api/source/sdp/{id}",
            Sdp = "",
            IgnoreRefclkGmid = true,
            Map = new List<int> { channelStart, channelStart + 1 },
        };
        _editTitle = $"Add Sink {id}";
        _isEdit = false;
        _editVisible = true;
    }

    private async Task CloseEdit()
    {
        _editVisible = false;
        _removeVisible = false;
        await FetchSinks();
    }

    private Task ApplyEdit() => CloseEdit();

    private async Task ConfirmRemove()
    {
        if (_removeSink == null)
        {
            return;
        }
        _removing = true;
        _removeError = null;
        try
        {
            await Api.DeleteSinkAsync(_removeSink.Id);
            await CloseEdit();
        }
        catch (DaemonApiException ex)
        {
            _removeError = $"Remove Sink failed: {ex.Message}";
        }
        finally
        {
            _removing = false;
        }
    }
}
